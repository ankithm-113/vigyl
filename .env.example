# Copy to .env for local development. Never commit .env.
# These override the matching fields in vigyl.config.json at load time.

# LLM provider. OpenAI is the default; the provider is picked automatically
# from whichever key is set (OpenAI wins if both are). Force it with VIGYL_PROVIDER.
OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# VIGYL_PROVIDER=openai
# VIGYL_MODEL=gpt-4o-mini

TELEGRAM_BOT_TOKEN=123456:xxx
VIGYL_WORKSPACE=/absolute/path/to/the/project/vigyl/controls
VIGYL_LOG_LEVEL=debug
