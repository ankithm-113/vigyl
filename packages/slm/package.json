{
  "name": "@vigylx/slm",
  "version": "0.2.0",
  "description": "Vigyl local inference service: classifies build failures on-device so the cloud model is only asked when it is actually needed.",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "clean": "node -e \"for (const p of ['dist','test-dist']) require('fs').rmSync(p,{recursive:true,force:true}); require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test --test-force-exit \"test-dist/**/*.test.js\"",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../../'+f, f)\""
  },
  "dependencies": {
    "@vigylx/daemon": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vigyl",
    "slm",
    "llama",
    "phi-3",
    "local-inference"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankithm-113/vigyl.git",
    "directory": "packages/slm"
  },
  "homepage": "https://github.com/ankithm-113/vigyl#readme",
  "bugs": {
    "url": "https://github.com/ankithm-113/vigyl/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Ankith M",
  "optionalDependencies": {
    "node-llama-cpp": "^3.22.0"
  }
}
