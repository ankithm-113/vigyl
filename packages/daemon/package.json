{
  "name": "@vigylx/daemon",
  "version": "0.1.0",
  "description": "Vigyl engine: Telegram bot, LLM supervisor, sandboxed self-healing command runner.",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "clean": "node -e \"for (const p of ['dist','test-dist']) require('fs').rmSync(p,{recursive:true,force:true}); require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "node -e \"require('fs').rmSync('test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test --test-force-exit \"test-dist/**/*.test.js\"",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../../'+f, f)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^16.4.5",
    "grammy": "^1.45.1",
    "openai": "^7.20.0",
    "winston": "^3.13.0",
    "ws": "^8.22.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vigyl",
    "telegram",
    "devops",
    "self-healing",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankithm-113/vigyl.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/ankithm-113/vigyl#readme",
  "bugs": {
    "url": "https://github.com/ankithm-113/vigyl/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Ankith M"
}
