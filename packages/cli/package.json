{
  "name": "@vigylx/cli",
  "version": "0.2.0",
  "description": "Control your server from Telegram in plain English. Self-healing builds, human approval for anything destructive.",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vigyl": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "clean": "node -e \"for (const p of ['dist','test-dist']) require('fs').rmSync(p,{recursive:true,force:true}); require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test --test-force-exit \"test-dist/**/*.test.js\"",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../../'+f, f)\""
  },
  "dependencies": {
    "@vigylx/daemon": "^0.2.0",
    "@vigylx/slm": "^0.2.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vigyl",
    "telegram",
    "devops",
    "cli",
    "self-healing",
    "openai",
    "chatops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankithm-113/vigyl.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ankithm-113/vigyl#readme",
  "bugs": {
    "url": "https://github.com/ankithm-113/vigyl/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Ankith M"
}
